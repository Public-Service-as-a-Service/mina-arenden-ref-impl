# Lösenord för databasanvändaren minaarenden (krävs). Generera t.ex. med: openssl rand -hex 16
DB_PASSWORD=byt-ut-mig
# Root-lösenord för MariaDB (valfritt, standard samma som DB_PASSWORD)
# DB_ROOT_PASSWORD=

# Producentens namn och prefix i kundhändelsetyper
MINA_ARENDEN_PRODUCENT=Referenskommunen
MINA_ARENDEN_PREFIX=REFKOM
MINA_ARENDEN_STANDARD_VERSION=6.1

# Läs in exempelhändelser vid första start (true/false)
MINA_ARENDEN_SEED=true

# Om satta krävs headrarna client_id och client_secret på /kundhandelseFragaSynkron.
# Måste sättas i par: bara den ena stoppar starten.
# CLIENT_ID=
# CLIENT_SECRET=

# Om satt krävs headern X-Api-Key på /kundhandelser
# ADMIN_API_KEY=

# I skarp drift: kräver alla tre nycklarna ovan vid start och stänger av exempeldata.
# SPRING_PROFILES_ACTIVE=production
