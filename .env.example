# Kopiera till .env för lokal körning med docker compose. I Dokploy sätts samma variabler under fliken Environment.

# Databas. DB_PASSWORD krävs. Generera t.ex. med: openssl rand -hex 24
# DB_ROOT_PASSWORD rekommenderas (annars samma som DB_PASSWORD). Byt det inte efter första deploy: MariaDB läser det
# bara när volymen skapas. DB_PASSWORD får bytas; db-prepare uppdaterar databasanvändaren vid nästa deploy.
DB_PASSWORD=byt-ut-mig
DB_ROOT_PASSWORD=byt-ut-mig-ocksa

# API-nycklar, kommaseparerade, minst 32 tecken var. Generera med: openssl rand -hex 32
# API_KEYS_ADMIN: allt, även inläsning till cachen (verksamhetssystem, drift). Krävs.
# API_KEYS_FRAGA: bara /{municipalityId}/kundhandelseFragaSynkron (vidareförmedlingstjänsten).
API_KEYS_ADMIN=
API_KEYS_FRAGA=

# Producent
MINA_ARENDEN_MUNICIPALITY_ID=2281
MINA_ARENDEN_PRODUCENT=Referenskommunen
MINA_ARENDEN_PREFIX=REFKOM
MINA_ARENDEN_STANDARD_VERSION=6.1

# Läs in exempelhändelser vid start om kommunen saknar kundhändelser (true/false). Endast demo.
MINA_ARENDEN_SEED=false

# Antal säkerhetskopior som sparas i volymen mariadb-backups (en per deploy)
DB_BACKUP_KEEP=10
